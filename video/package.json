{
	"name": "@canvist/video",
	"private": true,
	"version": "0.0.0",
	"description": "canvist's launch film, rendered with Remotion from real canvist footage",
	"license": "Unlicense",
	"type": "module",
	"scripts": {
		"prepare:footage": "node scripts/prepare.ts",
		"studio": "npm run prepare:footage && remotion studio src/index.ts",
		"render": "npm run prepare:footage && node scripts/render.ts",
		"render:preview": "npm run prepare:footage && node scripts/render.ts --preview",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.18"
	},
	"dependencies": {
		"@remotion/bundler": "4.0.541",
		"@remotion/cli": "4.0.541",
		"@remotion/fonts": "4.0.541",
		"@remotion/google-fonts": "4.0.541",
		"@remotion/renderer": "4.0.541",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"remotion": "4.0.541"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "7.0.2"
	}
}
