{
	"incremental": true,
	"indentWidth": 2,
	"useTabs": true,
	"exec": {
		"commands": [
			{
				"command": "rustup run nightly rustfmt --unstable-features --edition 2024",
				"exts": ["rs"]
			},
			{
				"command": "nixfmt",
				"exts": ["nix"]
			},
			{
				"command": "shfmt --filename {{file_path}} -i 0",
				"exts": ["sh", "bash"]
			},
			{
				"command": "tools/swift-format.sh",
				"exts": ["swift"],
				"cacheKeyFiles": [".swift-format", "tools/swift-format.sh"]
			},
			{
				"command": "tools/ktlint-format.sh {{file_path}}",
				"exts": ["kt", "kts"],
				"cacheKeyFiles": [".editorconfig", "tools/ktlint-format.sh"]
			}
		]
	},
	"typescript": {
		"deno": true,
		"useTabs": true,
		"module.sortExportDeclarations": "caseInsensitive",
		"module.sortImportDeclarations": "caseInsensitive"
	},
	"json": {
		"deno": true,
		"useTabs": true
	},
	"toml": {
		"useTabs": true,
		"indentWidth": 2,
		"cargo.applyConventions": true
	},
	"markdown": {
		"deno": true,
		"textWrap": "never"
	},
	"excludes": [
		"**/dist",
		"docs/book",
		".devenv/**",
		"**/fixtures",
		"**/snapshots",
		"**/target",
		"**/node_modules",
		".bin/",
		".local-cache/",
		"**/pkg/",
		"**/*.t.md",
		"platforms/dart/rust/src/frb_generated.rs",
		"packages/canvist-core/src/*.generated.ts",
		"packages/canvist-headless/wasm-full",
		"packages/canvist-headless/wasm",
		"packages/canvist-collab/wasm-full",
		"packages/canvist-collab/wasm",
		"packages/canvist-ssr/wasm",
		"packages/canvist-scene/wasm",
		"platforms/flutter/example/android/**",
		"platforms/flutter/example/ios/**",
		"platforms/apple/.build/**",
		"platforms/android/canvist/src/main/kotlin/io/github/ifiokjr/canvist/canvist_ffi.kt",
		"**/*.generated.swift",
		"**/Extensions.generated.kt",
		"platforms/android/**/build/**",
		"examples/react-native/ios/Pods/**",
		"examples/react-native/**/build/**",
		"packages/canvist-react-native/android/build/**"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.95.13.wasm",
		"https://plugins.dprint.dev/json-0.21.0.wasm",
		"https://plugins.dprint.dev/markdown-0.20.0.wasm",
		"https://plugins.dprint.dev/exec-0.6.0.json@a054130d458f124f9b5c91484833828950723a5af3f8ff2bd1523bd47b83b364",
		"https://plugins.dprint.dev/toml-0.7.0.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.1.wasm"
	]
}
