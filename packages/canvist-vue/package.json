{
	"name": "@canvist/vue",
	"version": "0.2.0",
	"description": "Vue bindings for the canvist canvas editor: a component, and composables typed from the extensions you register.",
	"license": "Unlicense",
	"homepage": "https://github.com/canvist/canvist/tree/main/packages/canvist-vue#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canvist/canvist.git",
		"directory": "packages/canvist-vue"
	},
	"bugs": {
		"url": "https://github.com/canvist/canvist/issues",
		"email": "support@canvist.dev"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"default": "./dist/mod.js"
		}
