{
	"name": "@canvist/react-native",
	"version": "0.2.0",
	"description": "The canvist rich-text editor for React Native: the native iOS and Android editors as a Fabric component, with commands and queries typed from the extensions you register.",
	"license": "Unlicense",
	"homepage": "https://github.com/canvist/canvist/tree/main/packages/canvist-react-native#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canvist/canvist.git",
		"directory": "packages/canvist-react-native"
	},
	"bugs": {
		"url": "https://github.com/canvist/canvist/issues",
		"email": "support@canvist.dev"
	},
	"keywords": [
		"react-native",
		"rich-text",
		"editor",
		"ios",
		"android",
		"fabric"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"react-native": "./src/mod.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"ios",
		"android/build.gradle",
		"android/src/main",
		"CanvistReactNative.podspec"
	],
	"sideEffects": false,
	"scripts": {
		"check:types": "tsc --noEmit",
		"test": "jest",
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@canvist/headless": "^0.2.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-native": ">=0.80.0"
	},
	"devDependencies": {
		"@react-native/babel-preset": "0.88.0",
		"@react-native/jest-preset": "0.88.0",
		"@testing-library/react-native": "^14.1.0",
		"@types/jest": "^29.5.14",
		"@types/react": "^19.2.0",
		"jest": "^29.7.0",
		"react": "19.3.0",
		"react-native": "0.88.0",
		"test-renderer": "^1.3.1",
		"typescript": "^7.0.2"
	},
	"codegenConfig": {
		"name": "CanvistReactNativeSpec",
		"type": "all",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "io.github.ifiokjr.canvist.reactnative"
		},
		"ios": {
			"componentProvider": {
				"CanvistEditorView": "CanvistEditorComponentView"
			},
			"modulesProvider": {
				"CanvistEditors": "CanvistEditorsModule"
			}
		}
	},
	"jest": {
		"preset": "@react-native/jest-preset",
		"testMatch": [
			"<rootDir>/tests/**/*.test.ts?(x)"
		],
		"transformIgnorePatterns": [
			"node_modules/(?!((jest-)?react-native|@react-native(-community)?|@canvist)/)"
		],
		"modulePaths": [
			"<rootDir>/node_modules"
		]
	}
}
