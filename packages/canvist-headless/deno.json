{
	"exports": {
		".": "./src/mod.ts",
		"./extensions": "./src/extensions.generated.ts",
		"./full": "./src/full.ts",
		"./native": "./src/native.ts",
		"./scene": "./src/scene.ts",
		"./ssr": "./src/ssr.ts"
	},
	"license": "Unlicense",
	"name": "@canvist/headless",
	"publish": {
		"exclude": [
			"!wasm/",
			"!wasm-full/",
			"!wasm-scene/",
			"!wasm-ssr/"
		],
		"include": [
			"src/**/*.ts",
			"wasm/*.js",
			"wasm/*.d.ts",
			"wasm/*.wasm",
			"wasm-full/*.js",
			"wasm-full/*.d.ts",
			"wasm-full/*.wasm",
			"wasm-scene/*.js",
			"wasm-scene/*.d.ts",
			"wasm-scene/*.wasm",
			"wasm-ssr/*.js",
			"wasm-ssr/*.d.ts",
			"wasm-ssr/*.wasm",
			"readme.md"
		]
	},
	"tasks": {
		"bench": "deno run --allow-read bench/overhead.ts",
		"server": "deno run --allow-read --allow-net examples/server/main.ts",
		"test": "deno test --allow-read --allow-net --allow-env tests/ examples/"
	},
	"version": "0.2.0"
}
