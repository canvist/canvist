{
	"name": "@canvist/ssr",
	"version": "0.3.0",
	"description": "Server-side rendering for canvist documents: semantic HTML and CSS laid out exactly as @canvist/web paints them, and SVG previews, for Node, Deno, Bun, and Workers.",
	"license": "Unlicense",
	"homepage": "https://github.com/canvist/canvist/tree/main/packages/canvist-ssr#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canvist/canvist.git",
		"directory": "packages/canvist-ssr"
	},
	"bugs": {
		"url": "https://github.com/canvist/canvist/issues",
		"email": "support@canvist.dev"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"default": "./dist/mod.js"
		},
		"./wasm/canvist_ssr_bg.wasm": "./wasm/canvist_ssr_bg.wasm"
	},
	"files": [
		"dist",
		"wasm/*.js",
		"wasm/*.d.ts",
		"wasm/*.wasm"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build:wasm": "cd ../.. && wasm-pack build crates/canvist_headless_wasm --target web --profile wasm-release --out-dir ../../packages/canvist-ssr/wasm --out-name canvist_ssr --no-pack -- --features ssr && rm packages/canvist-ssr/wasm/.gitignore",
		"check:types": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/*.test.ts",
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@canvist/core": "^0.3.0"
	},
	"devDependencies": {
		"@canvist/headless": "^0.3.0",
		"@types/node": "^24.0.0",
		"typescript": "^7.0.2"
	}
}
