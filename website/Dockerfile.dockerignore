# Docker reads this file for builds that use website/Dockerfile. The last
# matching line wins, and a line matches everything under a directory it
# names, so the exclusions that cut across directories come last.

# The Rust workspace builds the canvist packages (the crates, the Cargo
# files, and the manifests of every workspace member, which Cargo reads
# even to build one crate); the site reads the docs, the brand assets, and
# crate and package readmes. Everything else in the repository stays out.
/*
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!crates
!docs
!assets
!packages
!website
!examples
!platforms
!services
!tools
docs/*
!docs/src
!docs/Cargo.toml
examples/*
!examples/desktop
platforms/*
!platforms/dart
platforms/dart/*
!platforms/dart/rust
services/*
!services/cloud
!services/dictation
tools/*
!tools/footage
!tools/release
assets/*
!assets/brand
packages/*
!packages/*/README.md
!packages/*/readme.md
!packages/canvist-headless
!packages/canvist-web

# Installs and build output from a local checkout: the image makes its own.
**/node_modules
**/target
packages/*/dist
packages/*/wasm
packages/*/wasm-*
website/dist
website/.astro
website/test-results
website/playwright-report
website/lighthouse-reports
website/perf-reports
website/.lighthouseci
