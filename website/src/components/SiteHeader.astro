---
import { GITHUB_URL, lockup } from "../lib/brand.ts";
import ThemeToggle from "./ThemeToggle.astro";
import { routePath } from "../lib/route.ts";

const links = [
	{ href: "/docs", label: "Docs" },
	{ href: "/playground", label: "Playground" },
	{ href: "/services", label: "Services" },
	{ href: "/pricing", label: "Pricing" },
];
const path = routePath(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
	<a class="site-header__logo" href="/" aria-label="canvist home" set:html={lockup} />
	<nav class="site-header__nav" aria-label="Main">
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined} data-astro-prefetch>
							{link.label}
						</a>
					</li>
				))
			}
			<li>
				<a href={GITHUB_URL} class="site-header__gh">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
						></path>
					</svg>
					<span>GitHub</span>
				</a>
			</li>
		</ul>
	</nav>
	<ThemeToggle />
</header>

<style>
	.site-header {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: var(--s-4);
		max-width: calc(var(--content) + 2 * var(--chip-pad) + 2 * var(--gutter));
		margin-inline: auto;
		padding: var(--s-4) var(--gutter);
	}

	.site-header__logo {
		display: block;
		flex: none;
		width: 7.5rem;
		padding-block: var(--s-2);
		border-radius: var(--r-1);
	}

	.site-header__logo :global(svg) {
		width: 100%;
		height: auto;
	}

	.site-header__nav {
		margin-left: auto;
	}

	.site-header__nav ul {
		display: flex;
		gap: var(--s-1);
		padding: 0;
		list-style: none;
	}

	.site-header__nav a {
		display: inline-flex;
		align-items: center;
		gap: var(--s-2);
		min-height: 2.75rem;
		padding: 0 var(--s-3);
		border-radius: 999px;
		font-weight: 560;
		font-size: var(--t-small);
		text-decoration: none;
		transition: background-color var(--dur-1) var(--ease-out);
	}

	.site-header__nav a:hover {
		background: color-mix(in oklab, var(--text) 7%, transparent);
	}

	.site-header__nav a[aria-current="page"] {
		background: var(--text);
		color: var(--page);
	}

	@media (max-width: 40rem) {
		.site-header {
			flex-wrap: wrap;
			gap: var(--s-2);
			padding-bottom: var(--s-2);
		}

		.site-header__logo {
			width: 6.25rem;
		}

		.site-header__nav {
			order: 3;
			width: 100%;
			margin-left: calc(var(--s-3) * -1);
		}

		.site-header__nav a {
			padding: 0 var(--s-3);
		}

		.site-header__gh span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}
	}

	/* Five links share one row on phones. */
	@media (max-width: 26.25rem) {
		.site-header__nav ul {
			gap: 0;
		}

		.site-header__nav a {
			padding: 0 var(--s-2);
			font-size: var(--t-micro);
		}
	}

	@media (max-width: 21.25rem) {
		.site-header__nav a {
			padding: 0 var(--s-1);
		}
	}
</style>
