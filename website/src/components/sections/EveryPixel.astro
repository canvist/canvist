---
import { readFileSync } from "node:fs";
import { gzipSync } from "node:zlib";
import { findBudget, loadBudgets } from "../../lib/budgets.ts";
import { repoPath } from "../../lib/paths.ts";
import { renderPixelDocument } from "../../lib/pixel-render.ts";

// One real number from the repository's budget table, read at build time.
const keystroke = findBudget(loadBudgets(repoPath("docs/src/guides/performance.md")), "Apply one keystroke");

// The document as HTML, laid out as the editor will paint it. The build
// bundles the renderer away from its WebAssembly, so read that from the
// package.
const pixel = await renderPixelDocument(readFileSync(repoPath("packages/canvist-ssr/wasm/canvist_ssr_bg.wasm")));

// What loading the editor costs, measured from the module the page ships.
const wasmBytes = gzipSync(readFileSync(repoPath("packages/canvist-web/wasm/canvist_web_bg.wasm"))).byteLength;
const wasmKb = Math.round(wasmBytes / 10_240) * 10;
---

<section class="beat pixel" id="every-pixel" aria-labelledby="pixel-title">
	<div class="chip-inner pixel__grid">
		<div class="pixel__copy">
			<h2 id="pixel-title" class="section-title">Type into the real engine.</h2>
			<p class="lede beat-muted">
				This is canvist running in your browser. No contenteditable: every letter you type is laid out and painted by canvist itself.
			</p>
			<p class="pixel__proof">
				<a href="/docs/guides/performance#performance-budgets" data-astro-prefetch>
					<span class="pixel__number">{keystroke.today.text.replace(" ", " ")}</span>
					<span>per keystroke in a 100,000-block document</span>
				</a>
			</p>
		</div>

		<div class="sheet" data-pixel-demo data-state="idle">
			<style is:inline set:html={pixel.css} />
			<div class="sheet__paper" style={`--pixel-page: light-dark(${pixel.page.light}, ${pixel.page.dark})`}>
				<div class="sheet__editor" id="pixel-editor" data-pixel-editor set:html={pixel.html} />
				<div class="sheet__load">
					<button class="btn" type="button" data-pixel-start>
						<span data-pixel-start-label>Load the editor</span>
					</button>
					<p class="code-label" data-pixel-status>About {wasmKb} KB of WebAssembly</p>
				</div>
			</div>
			<p class="readout" aria-live="polite" data-pixel-readout>
				<span class="readout__label" data-pixel-source>Keystroke to paint</span>
				<span class="readout__value" data-pixel-last>–</span>
				<span class="readout__label">median</span>
				<span class="readout__value" data-pixel-p50>–</span>
			</p>
		</div>
	</div>
</section>

<style>
	.pixel__grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: var(--s-7) var(--s-8);
		align-items: center;
	}

	.pixel__copy {
		display: grid;
		gap: var(--s-5);
		align-content: start;
	}

	.pixel__proof a {
		display: inline-grid;
		gap: var(--s-1);
		text-decoration: none;
		color: var(--text-muted);
		font-size: var(--t-small);
	}

	.pixel__proof a:hover span:last-child {
		text-decoration: underline;
	}

	.pixel__number {
		color: var(--accent);
		font-size: var(--t-2);
		font-weight: 780;
		letter-spacing: -0.03em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.sheet {
		display: grid;
		gap: var(--s-3);
	}

	/*
	 * The sheet is the colour canvist paints behind the document
	 * (`--pixel-page`, from its stylesheet), so the opaque canvas meets the
	 * padding without a seam.
	 */
	.sheet__paper {
		position: relative;
		height: clamp(13rem, 24vw, 19rem);
		padding: clamp(var(--s-4), 2.4vw, var(--s-5));
		border-radius: var(--r-2);
		background: var(--pixel-page);
		box-shadow:
			0 1px 0 color-mix(in oklab, var(--ink) 8%, transparent),
			0 24px 48px -32px color-mix(in oklab, var(--paint) 45%, transparent);
		cursor: text;
	}

	/* The editor: its width from the sheet, no padding, and its own scrolling. */
	.sheet__editor {
		height: 100%;
		overflow: auto;
		overscroll-behavior: contain;
	}

	/* Sits over the empty end of the document until the editor has loaded. */
	.sheet__load {
		position: absolute;
		right: clamp(var(--s-4), 2.4vw, var(--s-5));
		bottom: clamp(var(--s-4), 2.4vw, var(--s-5));
		display: grid;
		justify-items: end;
		gap: var(--s-2);
		color: var(--text-muted);
	}

	.sheet[data-state="ready"] .sheet__load {
		display: none;
	}

	.sheet[data-state="loading"] [data-pixel-start] {
		opacity: 0.7;
		pointer-events: none;
	}

	/* The measurement prints itself in mono under the sheet: data, not decoration. */
	.readout {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--s-1) var(--s-3);
		font-family: var(--font-mono);
		font-variant-numeric: tabular-nums;
	}

	.readout__label {
		font-size: var(--t-micro);
		color: var(--text-muted);
	}

	/* Wide enough for "123.4 ms", so new numbers never move the labels. */
	.readout__value {
		min-width: 8ch;
		font-size: var(--t-small);
		font-weight: 600;
	}

	@media (max-width: 64rem) {
		.pixel__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
