{
	admin off
	auto_https off
	servers {
		# On Railway the connection arrives from the edge proxy, which uses
		# the RFC 6598 shared range beside the private ones. Trusting both
		# lets Caddy find the visitor's address in the proxy's
		# X-Forwarded-For; strict parsing walks from the right, so a
		# visitor's own header cannot name someone else.
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
	}
}

:{$PORT:8080} {
	# SITE_ROOT lets `deno task perf:serve` serve a local build the same way.
	root * {$SITE_ROOT:/srv}
	# The build writes Brotli and gzip copies beside every compressible file
	# (scripts/precompress.ts), which `file_server precompressed` serves as
	# they are. `encode` only covers a response without a copy.
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# canvist Cloud answers the admin dashboard's API and the site's own
	# analytics on this origin, so the admin session cookie stays first-party
	# and no third-party script runs. On Railway, CANVIST_CLOUD_URL is the
	# sync service's private address. Nothing here is ever cached.
	@cloud path /v1/events /v1/admin /v1/admin/*
	header @cloud Cache-Control "no-store"
	reverse_proxy @cloud {$CANVIST_CLOUD_URL:localhost:8080} {
		# Hand the visitor, not the edge proxy, to canvist Cloud's limiter.
		header_up X-Forwarded-For {client_ip}
	}

	# Hashed build output never changes; everything else revalidates.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@rest not path /_astro/* /v1/*
	header @rest Cache-Control "public, max-age=0, must-revalidate"

	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Pages are built as `name.html`; serve them at `/name`.
	try_files {path} {path}.html {path}/index.html
	file_server {
		precompressed br gzip
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server {
			precompressed br gzip
		}
	}
}
