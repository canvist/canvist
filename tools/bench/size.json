{
	"growthPercent": 1,
	"growthBytes": 1024,
	"approvalLabel": "size-increase-approved",
	"globalPaths": [
		".cargo",
		".github/workflows/bench-size.yml",
		"Cargo.lock",
		"Cargo.toml",
		"rust-toolchain.toml",
		"tools/bench"
	],
	"groups": {
		"core": {
			"paths": [
				"packages/canvist-core"
			],
			"build": [
				{
					"cwd": ".",
					"run": "[ ! -d packages/canvist-core ] || (cd packages/canvist-core && npm ci && npm run build)"
				}
			]
		},
		"headless": {
			"crates": [
				"canvist_headless_wasm"
			],
			"paths": [
				"packages/canvist-core",
				"packages/canvist-headless"
			],
			"needs": [
				"core"
			],
			"build": [
				{
					"cwd": "packages/canvist-headless",
					"run": "npm ci && npm run build:wasm && npm run build"
				}
			]
		},
		"collab": {
			"crates": [
				"canvist_headless_wasm"
			],
			"paths": [
				"packages/canvist-collab",
				"packages/canvist-core"
			],
			"needs": [
				"core"
			],
			"build": [
				{
					"cwd": ".",
					"run": "[ ! -d packages/canvist-collab ] || (cd packages/canvist-collab && npm ci && npm run build:wasm && npm run build)"
				}
			]
		},
		"ssr": {
			"crates": [
				"canvist_headless_wasm"
			],
			"paths": [
				"packages/canvist-core",
				"packages/canvist-ssr"
			],
			"needs": [
				"core"
			],
			"build": [
				{
					"cwd": ".",
					"run": "[ ! -d packages/canvist-ssr ] || (cd packages/canvist-ssr && npm ci && npm run build:wasm && npm run build)"
				}
			]
		},
		"scene": {
			"crates": [
				"canvist_headless_wasm"
			],
			"paths": [
				"packages/canvist-core",
				"packages/canvist-scene"
			],
			"needs": [
				"core"
			],
			"build": [
				{
					"cwd": ".",
					"run": "[ ! -d packages/canvist-scene ] || (cd packages/canvist-scene && npm ci && npm run build:wasm && npm run build)"
				}
			]
		},
		"web": {
			"crates": [
				"canvist_web",
				"canvist_headless_wasm"
			],
			"paths": [
				"packages/canvist-core",
				"packages/canvist-headless",
				"packages/canvist-web"
			],
			"needs": [
				"core",
				"headless"
			],
			"build": [
				{
					"cwd": "packages/canvist-web",
					"run": "npm ci && npm run build:wasm && npm run build && npx vite build --config tests/bundle/vite.config.ts --logLevel error"
				}
			]
		},
		"react": {
			"paths": [
				"packages/canvist-react"
			],
			"build": [
				{
					"cwd": "packages/canvist-react",
					"run": "npm ci && npx tsc -p tsconfig.build.json --noCheck"
				}
			]
		},
		"vue": {
			"paths": [
				"packages/canvist-vue"
			],
			"build": [
				{
					"cwd": "packages/canvist-vue",
					"run": "npm ci && npx tsc -p tsconfig.build.json --noCheck"
				}
			]
		},
		"canvas": {
			"crates": [
				"canvist_canvas_wasm"
			],
			"paths": [
				"packages/canvist-canvas"
			],
			"build": [
				{
					"cwd": "packages/canvist-canvas",
					"run": "deno task build:wasm"
				}
			]
		},
		"ffi": {
			"crates": [
				"canvist_ffi"
			],
			"build": [
				{
					"cwd": ".",
					"run": "cargo build --locked --release -p canvist_ffi --lib"
				}
			]
		},
		"apple": {
			"crates": [
				"canvist_ffi"
			],
			"paths": [
				"platforms/apple"
			]
		},
		"android": {
			"crates": [
				"canvist_ffi"
			],
			"paths": [
				"platforms/android"
			]
		}
	},
